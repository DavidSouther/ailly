{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ailly Analyzer",
  "version": "0.1.0",
  "identifier": "dev.ailly.analyzer",
  "build": {
    "beforeDevCommand": "npm --prefix client run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix client run build",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [{ "title": "Ailly Analyzer", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
